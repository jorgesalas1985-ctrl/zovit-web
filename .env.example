# Local
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Producción (Vercel) — URL canónica para SEO (robots, sitemap, Open Graph)
# NEXT_PUBLIC_APP_URL=https://zovit.cl

# Google Search Console (meta tag content=...)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=codigo_que_te_da_google

# Pagos (Sprint 5)
# ZOVIT_PAYMENT_PROVIDER=mock|mercadopago|webpay|stripe|bank_transfer

# Mercado Pago Checkout Pro
# MERCADOPAGO_ACCESS_TOKEN=TEST-...   (sandbox) o APP_USR-... (producción)

# Haulmer OpenFactura (boleta/factura electrónica SII)
# Emisor: Impresiones Getsemaní RUT 77.057.636-9
# HAULMER_DTE_ENABLED=true
# HAULMER_AUTO_EMIT=false
# HAULMER_ENV=production          # en Vercel production se asume production si se omite
# HAULMER_API_KEY=...             # obligatorio en producción (cuenta OpenFactura Getsemaní)
# HAULMER_USE_PUBLIC_SANDBOX=true # solo local/dev; nunca en producción
# HAULMER_GIRO_EMISOR=SERVICIOS DE IMPRESION Y PLATAFORMA DIGITAL
# HAULMER_ACTECO=...          # requerido solo para factura (33)
# HAULMER_CDG_SII_SUCUR=...   # requerido solo para factura (33)

# Opcional: mejora el análisis con un modelo externo (fase posterior)
# OPENAI_API_KEY=sk-...
